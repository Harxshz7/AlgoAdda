# ==============================================================================
# AlgoAdda Monorepo .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Java / Spring Boot / Maven (core-api)
# ------------------------------------------------------------------------------
**/target/
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
core-api/.mvn/wrapper/maven-wrapper.jar
**/.maven/
.mtj.tmp/

# ------------------------------------------------------------------------------
# 2. Python / FastAPI / vectorbt (backtest-service)
# ------------------------------------------------------------------------------
**/__pycache__/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
**/venv/
**/.venv/
**/env/
**/ENV/

# Pytest / Coverage
.cache
.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# ------------------------------------------------------------------------------
# 3. Node / React / TypeScript / Vite (web)
# ------------------------------------------------------------------------------
**/node_modules/
node_modules/
**/dist/
dist/
**/dist-ssr/
dist-ssr/
**/build/
.npm
*.tsbuildinfo
.eslintcache

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 4. Environment & Secrets (.env files)
# ------------------------------------------------------------------------------
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# ------------------------------------------------------------------------------
# 5. IDEs, Editors & OS Files
# ------------------------------------------------------------------------------
.idea/
**/.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project

# OS Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# 6. Database / Local Storage / Artifacts
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
local_storage/
minio_data/

